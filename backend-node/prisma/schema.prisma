generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  name           String
  email          String   @unique
  hashedPassword String?  @map("hashed_password")
  salt           String?
  role           String   @default("user")
  connectAccount String?  @map("connect_account")
  googleId       String?  @map("google_id")
  picture        String?
  createdAt      BigInt?  @map("created_at")
  updatedAt      BigInt?  @map("updated_at")

  preference       UserPreference?
  folders          Folder[]
  recipes          Recipe[]
  pantryItems      PantryItem[]
  shoppingListItems ShoppingListItem[]
  mealPlans        MealPlan[]
  usageQuota       UsageQuota?
  subscriptions    Subscription[]
  chatSessions     ChatSession[]
  aiMessages       AIMessage[]

  @@map("users")
}

model UsageQuota {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @map("user_id") @db.Uuid
  periodPlan         String  @default("monthly") @map("period_plan")
  periodStart        BigInt? @map("period_start")
  periodEnd          BigInt? @map("period_end")
  recipesCreated     Int     @default(0) @map("recipes_created")
  aiMessageSent      Int     @default(0) @map("ai_message_sent")
  recipesImported    Int     @default(0) @map("recipes_imported")
  imagesUploaded     Int     @default(0) @map("images_uploaded")
  aiPeriodStart      BigInt? @map("ai_period_start")
  monthlyPeriodStart BigInt? @map("monthly_period_start")
  createdAt          BigInt? @map("created_at")
  updatedAt          BigInt? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_quotas")
}

model SubscriptionPlan {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  billingPeriod String  @map("billing_period")
  priceCents    Int     @map("price_cents")
  currency      String  @default("USD")
  isActive      Boolean @default(true) @map("is_active")
  createdAt     BigInt? @map("created_at")
  updatedAt     BigInt? @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String  @id @default(uuid()) @db.Uuid
  userId                 String  @map("user_id") @db.Uuid
  planId                 String  @map("plan_id") @db.Uuid
  status                 String
  startAt                BigInt? @map("start_at")
  currentPeriodStart     BigInt? @map("current_period_start")
  currentPeriodEnd       BigInt? @map("current_period_end")
  cancelAt               BigInt? @map("cancel_at")
  provider               String  @default("stripe")
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @map("provider_subscription_id")
  createdAt              BigInt? @map("created_at")
  updatedAt              BigInt? @map("updated_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

model UserPreference {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @unique @map("user_id") @db.Uuid
  householdNotes       String? @map("household_notes") @db.Text
  measurementUnit      String? @map("measurement_unit") @default("metric")
  notes                String? @db.Text
  createdAt            BigInt? @map("created_at")
  updatedAt            BigInt? @map("updated_at")

  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergies            UserPreferenceAllergy[]
  dislikes             UserPreferenceDislike[]
  likes                UserPreferenceLike[]
  dietaryRestrictions  UserPreferenceDietaryRestriction[]

  @@map("user_preferences")
}

model UserPreferenceAllergy {
  preferenceId String @map("preference_id") @db.Uuid
  item         String
  preference   UserPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@id([preferenceId, item])
  @@map("user_preference_allergies")
}

model UserPreferenceDislike {
  preferenceId String @map("preference_id") @db.Uuid
  item         String
  preference   UserPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@id([preferenceId, item])
  @@map("user_preference_dislikes")
}

model UserPreferenceLike {
  preferenceId String @map("preference_id") @db.Uuid
  item         String
  preference   UserPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@id([preferenceId, item])
  @@map("user_preference_likes")
}

model UserPreferenceDietaryRestriction {
  preferenceId String @map("preference_id") @db.Uuid
  item         String
  preference   UserPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@id([preferenceId, item])
  @@map("user_preference_dietary_restrictions")
}

model Folder {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  name      String
  color     String?
  icon      String?
  createdAt BigInt? @map("created_at")
  updatedAt BigInt? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("folders")
}

model Ingredient {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String
  defaultUnit        String? @map("default_unit")
  unitKind           String? @map("unit_kind") @db.VarChar(32)
  baseUnit           String? @map("base_unit") @db.VarChar(32)
  defaultDisplayUnit String? @map("default_display_unit") @db.VarChar(32)
  imageUrl           String? @map("image_url")
  createdAt          BigInt? @map("created_at")
  updatedAt          BigInt? @map("updated_at")

  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[]
  shoppingListItems ShoppingListItem[]

  @@map("ingredients")
}

model Recipe {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  folderId      String? @map("folder_id") @db.Uuid
  mealName      String  @map("meal_name")
  description   String?
  instructions  String? @db.Text
  imageUrl      String? @map("image_url")
  imagePublicId String? @map("image_public_id")
  createdAt     BigInt? @map("created_at")
  updatedAt     BigInt? @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  steps       Step[]
  mealPlans   MealPlan[]

  @@index([userId], map: "idx_recipes_user")
  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid()) @db.Uuid
  recipeId     String  @map("recipe_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Float
  unit         String?
  note         String?
  createdAt    BigInt? @map("created_at")
  updatedAt    BigInt? @map("updated_at")

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId], map: "uk_recipe_ingredient")
  @@index([recipeId], map: "idx_recipe_ingredients_recipe")
  @@map("recipe_ingredients")
}

model Step {
  id           String  @id @default(uuid()) @db.Uuid
  recipeId     String  @map("recipe_id") @db.Uuid
  stepNo       Int     @map("step_no")
  instruction  String  @db.Text
  imageUrl     String? @map("image_url")
  timerSecond  String? @map("timer_second")
  createdAt    BigInt? @map("created_at")
  updatedAt    BigInt? @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("steps")
}

model PantryItem {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Float
  unit         String?
  notes        String?
  createdAt    BigInt? @map("created_at")
  updatedAt    BigInt? @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("pantry_items")
}

model ShoppingListItem {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @map("user_id") @db.Uuid
  ingredientId       String  @map("ingredient_id") @db.Uuid
  quantity           Float?
  unit               String?
  checked            Boolean @default(false)
  hasBeenAddedToPantry Boolean @default(false) @map("has_been_added_to_pantry")
  createdAt          BigInt? @map("created_at")
  updatedAt          BigInt? @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("shopping_list_items")
}

model MealPlan {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  recipeId    String  @map("recipe_id") @db.Uuid
  mealType    String? @map("meal_type")
  servingDate String? @map("serving_date")
  status      String  @default("PLANNED") @db.VarChar(32)
  createdAt   BigInt? @map("created_at")
  updatedAt   BigInt? @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId, servingDate], map: "idx_meal_plans_user_date")
  @@map("meal_plans")
}

model ChatSession {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  title     String  @default("New chat") @db.VarChar(200)
  isDefault Boolean @default(false) @map("is_default")
  lockedAt  BigInt? @map("locked_at")
  createdAt BigInt? @map("created_at")
  updatedAt BigInt? @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_chat_sessions_user_updated")
  @@map("chat_sessions")
}

model AIMessage {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  sessionId    String? @map("session_id") @db.Uuid
  role         String
  content      String  @db.Text
  responseType String? @map("response_type") @db.VarChar(64)
  cardData     Json?   @map("card_data")
  tokenIn      Int     @default(0) @map("token_in")
  tokenOut     Int     @default(0) @map("token_out")
  createdAt    BigInt? @map("created_at")
  updatedAt    BigInt? @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_ai_messages_user_created")
  @@index([sessionId, createdAt(sort: Desc)], map: "idx_ai_messages_session_created")
  @@map("ai_messages")
}

model InventoryAuditLog {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @map("user_id") @db.Uuid
  ingredientId       String  @map("ingredient_id") @db.Uuid
  pantryItemId       String? @map("pantry_item_id") @db.Uuid
  source             String  @db.VarChar(40)
  deltaQuantity      Float   @map("delta_quantity")
  previousQuantity   Float?  @map("previous_quantity")
  newQuantity        Float?  @map("new_quantity")
  unit               String
  mealPlanId         String? @map("meal_plan_id") @db.Uuid
  recipeId           String? @map("recipe_id") @db.Uuid
  shoppingListItemId String? @map("shopping_list_item_id") @db.Uuid
  note               String? @db.VarChar(500)
  createdAt          BigInt  @map("created_at")

  @@map("inventory_audit_logs")
}
